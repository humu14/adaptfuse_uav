# Split CSVs hold absolute local paths; the training/all-sample tables are large and
# regenerated by scripts/build_metadata.py. val/test splits are kept for evaluation.
code_p2/adaptfuse_uav/data/**/all_samples.csv
code_p2/adaptfuse_uav/data/**/train*.csv
*.cache
adaptfuse_od/.ultralytics/
images/generated/_backup_before_fontshrink/

